{
  "name": "dsh-feiyu-owner",
  "version": "0.2.0",
  "description": "给 DSH 里的肥鱼一份只属于主人的档案：认得主人、记得主人、多人场合优先主人，其他人照常回应；装好之后会自己弹一次「要不要认主」。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "owner",
    "memory",
    "ai-companion"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/speak.test.mjs tests/onboard.host.test.mjs tests/onboard.dismiss.test.mjs tests/client.render.test.mjs",
    "verify": "node tools/verify.mjs"
  }
}
